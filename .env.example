# Network（三仓库统一键名：只填裸 IP 与端口，其余自动组装）
# Ctrl 服务地址，供开发代理与常驻入口使用
CTRL_IP=127.0.0.1
CTRL_PORT=5000

# 常驻入口监听与证书配置（WEB_PORT / WEB_HOST 用于 npm start）
# WEB_PORT=5173
# WEB_IP=192.168.5.230
# WEB_HOST=0.0.0.0
# CTRL_SCHEME=https
# CTRL_TLS_VERIFY=false
# PROXY_TIMEOUT_MS=120000

# HTTPS 开关，默认 true；常驻入口没有独立的 HTTP 重定向端口
ENABLE_SSL=true
# 兼容键：旧配置或 shell 里的 VITE_ENABLE_SSL 优先于 ENABLE_SSL；新配置只写 ENABLE_SSL
# VITE_ENABLE_SSL=true
